# Production environment variables for UltraCrew frontend.
# This file documents the variable names only.
# The actual values are injected by Render at build time via the render.yaml
# envVars configuration — do NOT commit secret values here.
#
# On Render, VITE_API_BASE_URL is set to: https://ultracrew-api.onrender.com
# Vite bakes this into the static bundle at build time via import.meta.env.
#
VITE_API_BASE_URL=https://ultracrew-api.onrender.com