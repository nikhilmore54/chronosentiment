[Unit]
Description=RP-608 NSE Dedicated Prospective Shadow Observer Daemon (119 Symbols)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60s
StartLimitBurst=5

[Service]
Type=simple
User=ultraspeed
Group=ultraspeed
WorkingDirectory=/home/ultraspeed/ChronoSentiment_MEGA_FINAL
# Single writer. Do NOT pass --reset-outages here: Restart=always would clear
# outage counters on every crash loop and created twin writers beside ad-hoc launches.
ExecStart=/usr/bin/python3 -u scripts/run_rp608_nse_shadow_daemon.py
Restart=always
RestartSec=10s
TimeoutStopSec=15s
KillSignal=SIGTERM
UMask=0077
LimitNOFILE=65536
Environment=PYTHONUNBUFFERED=1
Environment=RP608_NSE_EXIT_POLICY=DYNAMIC_OHLCV_STRUCTURE_V1
Environment=RP608_NSE_ENTRY_PATH=TICK_PATH
# Gate 2E twin (crypto parity): PRIMARY allow_only; BASELINE ungated control.
# NEUTRAL needs train net_mean>0 for ALLOW. OF ±0.30 / traj / stops frozen (Gate 5).
# Books never pooled — separate journals under estimand_a_baseline_parallel_v1/.
Environment=RP608_NSE_PATTERN_GATE=allow_only
Environment=RP608_NSE_PATTERN_GATE_BASELINE=0
# Gate 2X floor-lock twin (authority 0%): ungated entry; immediate protect floor.
Environment=RP608_NSE_GATE2X_FLOOR_LOCK_TWIN=1
Environment=RP608_NSE_GATE2X_FLOOR_LOCK_RATCHET=0.50
# Adapter-side Coralys prior+preopen+phase gate (crates frozen; OF ±0.30 untouched).
Environment=RP608_NSE_CORALYS_INPUT_GATE=1
# Same plan-lifecycle client as crypto; fail-closed when bin/loop unavailable.
Environment=RP608_POSITION_DECIDE_BIN=/home/ultraspeed/ChronoSentiment_MEGA_FINAL/artifacts/deploy/chronosentiment/rp608_position_decide.aarch64-linux
Environment=RP608_GATE2X_MANAGE_BIN=/home/ultraspeed/ChronoSentiment_MEGA_FINAL/artifacts/deploy/chronosentiment/rp608_position_decide.aarch64-linux
Environment=RP608_PLAN_LIFECYCLE=1
Environment=RP608_PLAN_LIFECYCLE_REQUIRE_RUST=1
# Track B: Rust depth side-path only (Python remains authoritative depth_snapshots.jsonl)
Environment=RP608_NSE_DEPTH_WRITER=compare
# REC001h evidence required for Rust plan-lifecycle / Gate2X (missing dir → FATAL fail-closed).
Environment=RP608_NSE_REC001H_DIR=/home/ultraspeed/ChronoSentiment_MEGA_FINAL/datasets/recommendation/historical

[Install]
WantedBy=multi-user.target
