[Unit]
Description=RP-608 Dedicated Prospective Shadow Observer (Binance BTC/USDT)
After=network-online.target
Wants=network-online.target
# Allow longer post-reboot DNS settle; pair with in-process Clock EBO
StartLimitIntervalSec=600
StartLimitBurst=20

[Service]
Type=simple
User=ultraspeed
Group=ultraspeed
WorkingDirectory=/home/ultraspeed/ChronoSentiment_MEGA_FINAL
# Sole live launcher for crypto shadow. Do NOT also nohup this script —
# run_rp608_shadow_daemon acquires rp608_crypto_shadow.singleton.lock (exit 3 if held).
ExecStart=/usr/bin/python3 -u scripts/run_rp608_shadow_daemon.py
Restart=always
RestartSec=10s
TimeoutStopSec=15s
KillSignal=SIGTERM
UMask=0077
LimitNOFILE=65536
Environment=PYTHONUNBUFFERED=1
# Absolute paths — systemd PATH has no ~/bin; stale unsuffixed bin must not win.
Environment=RP608_POSITION_DECIDE_BIN=/home/ultraspeed/ChronoSentiment_MEGA_FINAL/artifacts/deploy/chronosentiment/rp608_position_decide.aarch64-linux
Environment=RP608_GATE2X_MANAGE_BIN=/home/ultraspeed/ChronoSentiment_MEGA_FINAL/artifacts/deploy/chronosentiment/rp608_position_decide.aarch64-linux
Environment=RP608_PLAN_LIFECYCLE=1
Environment=RP608_PLAN_LIFECYCLE_REQUIRE_RUST=1
Environment=RP608_CRYPTO_REC001H_DIR=/home/ultraspeed/ChronoSentiment_MEGA_FINAL/datasets/recommendation/historical_crypto
# Gate 2E: PRIMARY allow_only (no trade > bad); BASELINE twin control stays off.
Environment=RP608_CRYPTO_PATTERN_GATE=allow_only
Environment=RP608_CRYPTO_PATTERN_GATE_BASELINE=0
Environment=RP608_CRYPTO_PATTERN_EXIT_GATE=0
# OF paper entry quality (persist/depth) — stamp+suppress; NOT ±0.30 change
Environment=RP608_OF_PAPER_QUALITY_GATE=1

[Install]
WantedBy=multi-user.target
