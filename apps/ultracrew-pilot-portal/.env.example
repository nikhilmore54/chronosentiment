# UltraCrew Pilot Portal — environment variables
#
# Development: leave REACT_APP_API_URL empty.
#   The CRA dev server proxies /api/* to http://localhost:3001 automatically.
#
# Production (Vercel): set REACT_APP_API_URL to your Render backend URL.
#   This value is baked into the build at compile time by Create React App.
#   After changing it you must redeploy the frontend.

# Backend API base URL (no trailing slash)
# Example: https://ultracrew-api.onrender.com
REACT_APP_API_URL=