  "schema_notes": {
    "execution_seal_schema": {
      "entry_timestamp": "ISO8601",
      "entry_price": "number — actual paper fill price",
      "entry_source": "string — e.g. session_open, mid_session",
      "target_price": "number — derived from entry_price + target_pct",
      "target_pct": "number — from execution contract or Coralys",
      "risk_boundary": "number or null — derived from entry_price - risk_pct",
      "risk_pct": "number or null",
      "maximum_hold_sessions": "integer",
      "execution_contract": "string",
      "coralys_execution_artifact": "string or null",
      "intent_hash": "string — SHA256 of sealed execution intent",
      "sealed_at": "ISO8601"
    },
    "monitoring_schema": {
      "sessions_elapsed": "integer",
      "current_session": "string — ISO8601 date",
      "last_certified_state": "object",
      "risk_boundary_history": [
        {
          "session": "ISO8601 date",
          "previous_boundary": "number",
          "new_boundary": "number",
          "reason": "string",
          "coralys_state": "object"
        }
      ],
      "note": "Risk boundary may only tighten (LONG: new >= previous, SHORT: new <= previous)"
    },
    "exit_record_schema": {
      "exit_timestamp": "ISO8601",
      "exit_price": "number — actual paper fill price",
      "exit_reason": "TARGET | RISK | HORIZON",
      "trigger_type": "HIGH_REACHED | LOW_REACHED | GAP_THROUGH | SESSION_CLOSE | RISK_BOUNDARY",
      "trigger_session": "ISO8601 date",
      "trigger_timestamp": "ISO8601",
      "trigger_session_ohlc": {
        "open": "number",
        "high": "number",
        "low": "number",
        "close": "number"
      },
      "holding_sessions": "integer",
      "realized_return": "number — (exit_price - entry_price) / entry_price, direction-adjusted",
      "decision_value": "number"
    }
  }
}